-- ========== ЛОГИКА ==========
local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil
end

local function getRealCandyCount()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            local n = stat.Name:lower()
            if n:find("candy") or n:find("sweet") then return stat.Value end
        end
    end
    return localCandyCount
end

local function findCandies()
    local candies = {}
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return candies end
    local playerPos = char.HumanoidRootPart.Position

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            if obj.Transparency < 1 then
                local nameLower = obj.Name:lower()
                for _, target in ipairs(CANDY_NAMES) do
                    if nameLower:find(target) then
                        -- Ограничиваем радиус поиска, чтобы не летать через всю карту
                        if (playerPos - obj.Position).Magnitude <= SCAN_RADIUS then
                            table.insert(candies, obj)
                        end
                        break
                    end
                end
            end
        end
    end
    return candies
end

local function flyToPart(targetPart)
    local char, hrp, hum = getCharacter()
    if not hrp or not targetPart or not targetPart.Parent then return false end
    
    local targetPos = targetPart.Position 
    local distance = (hrp.Position - targetPos).Magnitude
    local timeToFly = distance / FLY_SPEED
    if timeToFly < 0.15 then timeToFly = 0.15 end
    
    local tweenInfo = TweenInfo.new(timeToFly, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    tween:Play()
    tween.Completed:Wait()
    
    task.wait(0.05)
    return true
end

local function farmLoop()
    local diedConnection
    local lastHum

    while farming do
        local char, hrp, hum = getCharacter()
        
        if not char then
            task.wait(1)
            continue
        end

        if hum ~= lastHum then
            if diedConnection then diedConnection:Disconnect() end
            lastHum = hum
            diedConnection = hum.Died:Connect(function()
                localCandyCount = 0
            end)
        end

        local currentCount = getRealCandyCount()
        
        if currentCount >= MAX_CANDY or localCandyCount >= MAX_CANDY then
            if hum and hum.Health > 0 then hum.Health = 0 end
            localCandyCount = 0
            task.wait(4) 
            continue
        end

        local candies = findCandies()
        
        if #candies > 0 then
            table.sort(candies, function(a, b)
                return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
            end)

            for _, candy in ipairs(candies) do
                if not farming then break end
                if not getCharacter() then break end 
                if getRealCandyCount() >= MAX_CANDY or localCandyCount >= MAX_CANDY then break end

                if candy and candy.Parent then
                    flyToPart(candy)
                    localCandyCount = localCandyCount + 1
                    totalCollected = totalCollected + 1 
                end
            end
        else
            -- Если конфет в радиусе нет, ждем (не летим через всю карту)
            task.wait(0.5)
        end
    end

    if diedConnection then diedConnection:Disconnect() end
end

