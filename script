-- ========== ЛОГИКА ==========
local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil
end

local function getRealCandyCount()
    -- 1. Проверяем leaderstats
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            local n = stat.Name:lower()
            if n:find("candy") or n:find("sweet") then return stat.Value end
        end
    end
    -- 2. Проверяем PlayerGui (интерфейс игры)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, obj in ipairs(playerGui:GetDescendants()) do
            if (obj:IsA("TextLabel") or obj:IsA("IntValue")) and obj.Name:lower():find("candy") then
                if obj:IsA("TextLabel") and tonumber(obj.Text) then return tonumber(obj.Text) end
                if obj:IsA("IntValue") then return obj.Value end
            end
        end
    end
    -- 3. Если не нашли, используем локальный счетчик
    return localCandyCount
end

local function findCandies()
    local candies = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Part") then
            local nameLower = obj.Name:lower()
            for _, target in ipairs(CANDY_NAMES) do
                if nameLower:find(target) then
                    if not obj:IsDescendantOf(LocalPlayer.Character) then
                        table.insert(candies, obj)
                    end
                    break
                end
            end
        end
    end
    return candies
end

-- Плавный полет со скоростью 21
local function flyToPart(targetPart)
    local char, hrp, hum = getCharacter()
    if not hrp or not targetPart or not targetPart.Parent then return false end
    
    -- Берем позицию конфеты, добавляем 2 стада вверх, чтобы не застрять в полу
    local targetPos = targetPart.Position + Vector3.new(0, 2, 0)
    local distance = (hrp.Position - targetPos).Magnitude
    
    -- Время = Расстояние / Скорость (21)
    local timeToFly = distance / FLY_SPEED
    if timeToFly < 0.2 then timeToFly = 0.2 end -- Минимальное время полета
    
    local tweenInfo = TweenInfo.new(timeToFly, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    tween:Play()
    tween.Completed:Wait()
    
    task.wait(0.05) -- Небольшая пауза для регистрации сбора
    return true
end

local function farmLoop()
    while farming do
        local char, hrp, hum = getCharacter()
        
        if not char then
            task.wait(1)
            continue
        end

        -- Отслеживаем смерть для сброса локального счетчика
        hum.Died:Connect(function()
            localCandyCount = 0
        end)

        local currentCount = getRealCandyCount()
        
        -- Авто-ресет при 50 конфетах
        if currentCount >= MAX_CANDY or localCandyCount >= MAX_CANDY then
            if hum and hum.Health > 0 then 
                hum.Health = 0 
            end
            localCandyCount = 0
            task.wait(4) -- Ждем респавна и загрузки карты
            continue
        end

        local candies = findCandies()
        
        if #candies > 0 then
            -- Сортируем по ближайшему расстоянию
            table.sort(candies, function(a, b)
                return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
            end)

            for _, candy in ipairs(candies) do
                if not farming then break end
                if not getCharacter() then break end 
                if getRealCandyCount() >= MAX_CANDY or localCandyCount >= MAX_CANDY then break end

                if candy and candy.Parent then
                    flyToPart(candy)
                    localCandyCount = localCandyCount + 1
                end
            end
        else
            -- Если конфет нет (лобби или перерыв между раундами), просто ждем
            task.wait(0.5)
        end
    end
end

