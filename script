-- ========== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ==========
local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil
end

local function teleportTo(position)
    local char, hrp, hum = getCharacter()
    if not hrp then return end
    -- Плавный/мгновенный телепорт с небольшим смещением, чтобы не застревать в текстурах
    hrp.CFrame = CFrame.new(position + Vector3.new(0, 5, 0))
end

local function resetCharacter()
    local char, hrp, hum = getCharacter()
    if hum then
        hum.Health = 0
    end
end

-- Поиск всех конфет в Workspace
local function findCandies()
    local candies = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find(CANDY_NAME:lower()) then
            -- Исключаем части персонажа, чтобы не телепортироваться к себе
            if not obj:IsDescendantOf(LocalPlayer.Character or game) then
                table.insert(candies, obj)
            end
        end
    end
    return candies
end

-- Попытка получить количество конфет из мешка/инвентаря
local function getCandyCount()
    -- Если есть объект с именем мешка, можно попробовать прочитать Value
    -- Это заглушка: в разных билдах MM2 данные могут лежать в PlayerGui, ReplicatedStorage или на персонаже.
    -- Если у тебя есть точный путь — замени эту функцию.
    local char = LocalPlayer.Character
    if char then
        local bag = char:FindFirstChild(BAG_NAME, true)
        if bag and bag:IsA("IntValue") then
            return bag.Value
        end
    end
    -- Если не нашли — возвращаем локальный счётчик (сколько телепортаций к конфетам сделали)
    return candyCollected
end

-- ========== ЛОГИКА ФАРМА ==========
local function waitForRoundAndGoUnderMap()
    -- Ждём, пока появится персонаж
    while not getCharacter() do task.wait(0.5) end
    -- Небольшая задержка, чтобы раунд успел инициализироваться
    task.wait(WAIT_BEFORE_FARM)
    -- Улетаем под карту
    teleportTo(underMapPosition)
end

local function farmLoop()
    while farming do
        local char, hrp, hum = getCharacter()
        if not char then
            task.wait(1)
            continue
        end

        -- Если мы не под картой — возвращаем под карту
        if hrp.Position.Y > SAFE_Y + 100 then
            teleportTo(underMapPosition)
            task.wait(0.5)
        end

        -- Ищем конфеты
        local candies = findCandies()
        if #candies > 0 then
            for _, candy in ipairs(candies) do
                if not farming then break end
                -- Телепортируемся чуть выше конфеты, чтобы задеть хитбоксом
                local pos = candy.Position
                teleportTo(pos)
                candyCollected = candyCollected + 1
                task.wait(FARM_SPEED)
            end
        else
            -- Конфет пока нет — просто висим под картой
            teleportTo(underMapPosition)
            task.wait(1)
        end

        -- Проверка заполнения мешка
        local currentCount = getCandyCount()
        if currentCount >= MAX_CANDY then
            resetCharacter()
            candyCollected = 0
            task.wait(2) -- ждём респавна
            if farming then
                waitForRoundAndGoUnderMap()
            end
        end

        task.wait(0.1)
    end
end

-- ========== ОБНОВЛЕНИЕ GUI ==========
local function updateStats()
    if not statsVisible then return end
    local elapsed = math.floor(tick() - farmStartTime)
    local mins = math.floor(elapsed / 60)
    local secs = elapsed % 60
    timerLabel.Text = string.format("Таймер: %02d:%02d", mins, secs)
    candyLabel.Text = "Конфет: " .. tostring(candyCollected)
end

RunService.RenderStepped:Connect(function()
    if statsVisible and farming then
        updateStats()
    end
end)

-- ========== ОБРАБОТЧИКИ КНОПОК ==========
farmBtn.MouseButton1Click:Connect(function()
    farming = not farming
    if farming then
        farmBtn.Text = "Auto Farm: ON"
        farmBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        farmStartTime = tick()
        candyCollected = 0
        -- Запускаем фарм в отдельном потоке
        task.spawn(function()
            waitForRoundAndGoUnderMap()
            farmLoop()
        end)
    else
        farmBtn.Text = "Auto Farm: OFF"
        farmBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        -- Возвращаем персонажа на поверхность (опционально)
        local char, hrp, hum = getCharacter()
        if hrp then
            hrp.CFrame = CFrame.new(0, 50, 0) -- примерная безопасная точка на поверхности
        end
    end
end)

statsBtn.MouseButton1Click:Connect(function()
    statsVisible = not statsVisible
    statsFrame.Visible = statsVisible
    statsBtn.Text = "Stats: " .. (statsVisible and "ON" or "OFF")
    statsBtn.BackgroundColor3 = statsVisible and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(50, 80, 200)
    if statsVisible then
        updateStats()
    end
end)

-- Перетаскивание окна статистики (опционально)
statsFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local startPos = input.Position
        local startFramePos = statsFrame.Position
        local conn
        conn = UserInputService.InputChanged:Connect(function(moveInput)
            if moveInput.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = moveInput.Position - startPos
                statsFrame.Position = UDim2.new(
                    startFramePos.X.Scale,
                    startFramePos.X.Offset + delta.X,
                    startFramePos.Y.Scale,
                    startFramePos.Y.Offset + delta.Y
                )
            end
        end)
        UserInputService.InputEnded:Connect(function(endInput)
            if endInput.UserInputType == Enum.UserInputType.MouseButton1 then
                if conn then conn:Disconnect() end
            end
        end)
    end
end)

