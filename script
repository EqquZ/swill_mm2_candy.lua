-- ========== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ==========
local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil
end

local function findCandies()
    local candies = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("MeshPart") then
            local nameLower = obj.Name:lower()
            for _, targetName in ipairs(CANDY_NAMES) do
                if nameLower:find(targetName) then
                    -- Исключаем части персонажа
                    if not obj:IsDescendantOf(LocalPlayer.Character or game) then
                        table.insert(candies, obj)
                    end
                    break
                end
            end
        end
    end
    return candies
end

-- ========== ЛОГИКА ФАРМА ==========
local function farmLoop()
    while farming do
        local char, hrp, hum = getCharacter()
        if not char then
            task.wait(1)
            continue
        end

        -- Проверка на лобби (в MM2 лобби обычно называется "Lobby")
        local isLobby = Workspace:FindFirstChild("Lobby") ~= nil
        
        if isLobby then
            -- Если мы в лобби, просто ждем начала раунда, ничего не делаем
            task.wait(1)
            continue
        end

        -- Проверка заполнения мешка (50 конфет)
        if candyCollected >= MAX_CANDY then
            if hum then
                hum.Health = 0 -- Авто-ресет
            end
            candyCollected = 0
            task.wait(3) -- Ждем респавна
            continue
        end

        -- Поиск и сбор конфет
        local candies = findCandies()
        if #candies > 0 then
            for _, candy in ipairs(candies) do
                if not farming then break end
                
                -- Проверяем, что мы все еще в игре, а не в лобби, и персонаж жив
                if Workspace:FindFirstChild("Lobby") or not getCharacter() then break end
                
                if candy and candy.Parent then
                    -- Телепортируемся прямо к конфете
                    hrp.CFrame = CFrame.new(candy.Position + Vector3.new(0, 2, 0))
                    candyCollected = candyCollected + 1
                    task.wait(FARM_SPEED)
                end
            end
        else
            task.wait(0.5)
        end

        task.wait(0.1)
    end
end

-- ========== ОБНОВЛЕНИЕ GUI ==========
local function updateStats()
    if not statsVisible then return end
    -- Используем os.clock() для точного таймера
    local elapsed = math.floor(os.clock() - farmStartTime)
    local mins = math.floor(elapsed / 60)
    local secs = elapsed % 60
    timerLabel.Text = string.format("Таймер: %02d:%02d", mins, secs)
    candyLabel.Text = "Конфет: " .. tostring(candyCollected)
end

-- Обновляем таймер каждый кадр, если открыто окно Stats
RunService.RenderStepped:Connect(function()
    if statsVisible then
        updateStats()
    end
end)

