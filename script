-- ========== ЛОГИКА ==========
local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil
end

local function getRealCandyCount()
    -- В некоторых обновлениях MM2 данные лежат в ReplicatedStorage или PlayerGui
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            local name = stat.Name:lower()
            if name:find("candy") or name:find("coin") or name:find("sweet") or name:find("event") then
                return stat.Value
            end
        end
    end
    return localCandyCount
end

local function findCandies()
    local candies = {}
    -- Ищем конфеты везде, где только можно
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("Part") then
            local nameLower = obj.Name:lower()
            for _, target in ipairs(CANDY_NAMES) do
                if nameLower:find(target) then
                    if not obj:IsDescendantOf(LocalPlayer.Character) then
                        table.insert(candies, obj)
                    end
                    break
                end
            end
        end
    end
    return candies
end

-- Плавный полет (Tween), чтобы обойти античит
local function flyToPart(targetPart)
    local char, hrp, hum = getCharacter()
    if not hrp or not targetPart or not targetPart.Parent then return false end
    
    local targetPos = targetPart.Position
    local distance = (hrp.Position - targetPos).Magnitude
    
    -- Если конфета слишком далеко, летим с расчетом скорости
    local timeToFly = distance / 100 * FLY_SPEED
    if timeToFly < 0.5 then timeToFly = 0.5 end -- Минимум полсекунды на полет
    
    local tweenInfo = TweenInfo.new(timeToFly, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    tween:Play()
    tween.Completed:Wait()
    
    -- Пауза для сбора
    task.wait(0.1) 
    return true
end

local function farmLoop()
    while farming do
        local char, hrp, hum = getCharacter()
        
        if not char then
            -- Персонаж мертв или загружается
            task.wait(1)
            continue
        end

        local currentCount = getRealCandyCount()
        
        -- Авто-ресет при 50 конфетах
        if currentCount >= MAX_CANDY then
            if hum then hum.Health = 0 end
            localCandyCount = 0
            task.wait(3) -- Ждем респавна
            continue
        end

        local candies = findCandies()
        
        if #candies > 0 then
            table.sort(candies, function(a, b)
                return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
            end)

            for _, candy in ipairs(candies) do
                if not farming then break end
                if not getCharacter() then break end 
                if getRealCandyCount() >= MAX_CANDY then break end

                if candy and candy.Parent then
                    flyToPart(candy)
                    localCandyCount = localCandyCount + 1
                end
            end
        else
            -- Если конфет нет (лобби), просто висим
            task.wait(0.5)
        end
    end
end

