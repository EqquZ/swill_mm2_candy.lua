-- ========== ANTI-FLING ==========
RunService.Heartbeat:Connect(function()
    if LocalPlayer.Character then
        local char = LocalPlayer.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hrp and hum and hum.Health > 0 then
            if not farming and hrp.AssemblyLinearVelocity.Magnitude < 10 and hrp.Position.Y > -50 then
                lastSafePosition = hrp.CFrame
            end

            if antiFlingEnabled then
                if hrp.AssemblyLinearVelocity.Magnitude > ANTI_FLING_SPEED_LIMIT or hrp.AssemblyAngularVelocity.Magnitude > 50 then
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end

                if hrp.Position.Y < -50 then
                    if lastSafePosition then hrp.CFrame = lastSafePosition else hrp.CFrame = CFrame.new(0, 50, 0) end
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end
end)

-- ========== ЛОГИКА ФАРМА ==========
local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil
end

local function getRealCandyCount()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            local n = stat.Name:lower()
            if n:find("candy") or n:find("sweet") or n:find("event") or n:find("coin") then 
                return stat.Value 
            end
        end
    end
    return localCandyCount
end

local function getClosestCandy(hrp)
    local closestCandy = nil
    local shortestDistance = SCAN_RADIUS 
    local now = tick()

    for obj, timeProcessed in pairs(processedCandies) do
        if now - timeProcessed > 2 or not obj.Parent then
            processedCandies[obj] = nil
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Transparency < 1 then
            local nameLower = obj.Name:lower()
            for _, target in ipairs(CANDY_NAMES) do
                if nameLower:find(target) then
                    if not processedCandies[obj] then
                        local dist = (hrp.Position - obj.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestCandy = obj
                        end
                    end
                    break
                end
            end
        end
    end
    return closestCandy
end

local function farmLoop()
    local diedConnection
    local lastHum
    local currentTarget = nil
    local targetStartTime = 0

    enableNoclip()

    while farming do
        local char, hrp, hum = getCharacter()
        
        if not char then
            task.wait(1)
            continue
        end

        if hum ~= lastHum then
            if diedConnection then diedConnection:Disconnect() end
            lastHum = hum
            diedConnection = hum.Died:Connect(function()
                localCandyCount = 0
                processedCandies = {}
                currentTarget = nil
            end)
        end

        local currentCount = getRealCandyCount()
        
        -- Проверка на полный мешок (Auto Reset)
        if currentCount >= MAX_CANDY or (currentCount == localCandyCount and localCandyCount >= MAX_CANDY) then
            hum.PlatformStand = false
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            
            if autoResetEnabled then
                if hum and hum.Health > 0 then 
                    hum.Health = 0 
                end
                task.wait(4) 
            else
                task.wait(1)
            end
            continue
        end

        -- Если цели нет или она исчезла
        if not currentTarget or not currentTarget.Parent then
            currentTarget = getClosestCandy(hrp)
            targetStartTime = tick()
        end

        if currentTarget then
            hum.PlatformStand = true
            
            local targetPos = currentTarget.Position
            local distance = (hrp.Position - targetPos).Magnitude
            
            -- Если подлетели ОЧЕНЬ близко (пролетаем сквозь) - считаем собранной
            if distance < 2.5 then
                processedCandies[currentTarget] = tick() 
                localCandyCount = localCandyCount + 1
                totalCollected = totalCollected + 1
                currentTarget = nil
            else
                -- Если летим к цели больше 5 секунд, бросаем её
                if tick() - targetStartTime > 5 then
                    processedCandies[currentTarget] = tick()
                    currentTarget = nil
                else
                    local direction = (targetPos - hrp.Position).Unit
                    
                    local currentSpeed = FLY_SPEED
                    if distance < 15 then
                        currentSpeed = APPROACH_SPEED
                    end
                    
                    hrp.AssemblyLinearVelocity = direction * currentSpeed
                end
            end
        else
            hum.PlatformStand = false
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            currentTarget = nil
        end

        RunService.Heartbeat:Wait()
    end

    if diedConnection then diedConnection:Disconnect() end
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    disableNoclip()
end

