RunService.RenderStepped:Connect(function()
    if statsVisible then
        local elapsed = math.floor(os.clock() - scriptStartTime)
        timerLabel.Text = string.format("Время: %02d:%02d", math.floor(elapsed/60), elapsed%60)
        
        local displayCount = getRealCandyCount()
        candyLabel.Text = "Собрано: " .. tostring(displayCount) .. " / " .. tostring(MAX_CANDY)
        totalLabel.Text = "Собрано всего: " .. tostring(totalCollected)
    end
end)

farmBtn.MouseButton1Click:Connect(function()
    farming = not farming
    if farming then
        farmBtn.Text = "Auto Farm: ON"
        farmBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        localCandyCount = 0 
        task.spawn(farmLoop)
    else
        farmBtn.Text = "Auto Farm: OFF"
        farmBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        -- При выключении возвращаем коллизии, чтобы персонаж не провалился под карту
        if LocalPlayer.Character then
            for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = true end
            end
        end
    end
end)

statsBtn.MouseButton1Click:Connect(function()
