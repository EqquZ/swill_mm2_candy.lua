-- ========== REAL ANTI-FLING (Защита от читеров) ==========
RunService.Heartbeat:Connect(function()
    if antiFlingEnabled and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hrp and hum and hum.Health > 0 then
            -- 1. Сброс аномальной скорости (если кто-то применил флинг)
            if hrp.AssemblyLinearVelocity.Magnitude > ANTI_FLING_SPEED_LIMIT or hrp.AssemblyAngularVelocity.Magnitude > 50 then
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                -- Возвращаем на последнюю безопасную позицию при сильном флинге
                if lastSafePosition and not farming then
                    hrp.CFrame = lastSafePosition
                end
            end

            -- 2. Защита от изменения свойств физики (эксплойты часто ломают CanCollide)
            if not farming then
                -- Если мы не летим сами, принудительно возвращаем коллизию и выключаем платформу
                if not hrp.CanCollide then hrp.CanCollide = true end
                if hum.PlatformStand then hum.PlatformStand = false end
                
                -- Запоминаем безопасную позицию, если мы не в полете и не падаем
                if hrp.Position.Y > -50 and hrp.AssemblyLinearVelocity.Magnitude < 10 then
                    lastSafePosition = hrp.CFrame
                end
            end

            -- 3. Anti-Void (защита от падения под карту)
            if hrp.Position.Y < -50 then
                if lastSafePosition then
                    hrp.CFrame = lastSafePosition
                else
                    hrp.CFrame = CFrame.new(0, 50, 0) 
                end
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

-- ========== ЛОГИКА ФАРМА ==========
local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil
end

local function getRealCandyCount()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            local n = stat.Name:lower()
            if n:find("candy") or n:find("sweet") then return stat.Value end
        end
    end
    return localCandyCount
end

local function getClosestCandy(hrp)
    local closestCandy = nil
    local shortestDistance = SCAN_RADIUS 

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Transparency < 1 then
            local nameLower = obj.Name:lower()
            for _, target in ipairs(CANDY_NAMES) do
                if nameLower:find(target) then
                    local yDiff = math.abs(hrp.Position.Y - obj.Position.Y)
                    if yDiff <= 50 then
                        local dist = (hrp.Position - obj.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            closestCandy = obj
                        end
                    end
                    break
                end
            end
        end
    end
    return closestCandy
end

-- Функция полета с временным отключением коллизии
local function flyToPart(targetPart)
    local char, hrp, hum = getCharacter()
    if not hrp or not targetPart or not targetPart.Parent then return false end
    
    -- Включаем Noclip и отключаем гравитацию ТОЛЬКО на время полета
    hum.PlatformStand = true
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end

    local startTime = tick()
    while farming and targetPart and targetPart.Parent do
        local currentChar, currentHrp = getCharacter()
        if not currentHrp then break end
        
        local distance = (currentHrp.Position - targetPart.Position).Magnitude
        if distance < 3 then break end
        
        local direction = (targetPart.Position - currentHrp.Position).Unit
        currentHrp.AssemblyLinearVelocity = direction * FLY_SPEED
        
        if tick() - startTime > 3 then break end
        RunService.Heartbeat:Wait()
    end
    
    -- Возвращаем физику обратно после подлета (или если прервались)
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hum.PlatformStand = false
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
    end
    
    task.wait(0.1)
    return true
end

local function farmLoop()
    local diedConnection
    local lastHum

    while farming do
        local char, hrp, hum = getCharacter()
        
        if not char then
            task.wait(1)
            continue
        end

        if hum ~= lastHum then
            if diedConnection then diedConnection:Disconnect() end
            lastHum = hum
            diedConnection = hum.Died:Connect(function()
                localCandyCount = 0
            end)
        end

        local currentCount = getRealCandyCount()
        
        if currentCount >= MAX_CANDY or localCandyCount >= MAX_CANDY then
            if hum and hum.Health > 0 then hum.Health = 0 end
            localCandyCount = 0
            task.wait(4) 
            continue
        end

        local candy = getClosestCandy(hrp)
        
        if candy then
            flyToPart(candy)
            localCandyCount = localCandyCount + 1
            totalCollected = totalCollected + 1 
        else
            task.wait(0.5)
        end
    end

    if diedConnection then diedConnection:Disconnect() end
end

